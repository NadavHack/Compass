menu "LoRa Configuration"

# Symbol names are the original unprefixed ones so that saved sdkconfig values
# keep working. They feed the LORA_DEFAULT_* macros in include/lora.h, which is
# what lora_init() uses; on the Pico, where there is no menuconfig, pass a
# lora_config_t to lora_init_config() instead.

config CS_GPIO
    int "CS GPIO"
    range 0 48
    default 15
    help
	Pin Number where the NCS pin of the LoRa module is connected to.

config RST_GPIO
    int "RST GPIO"
    range -1 48
    default 32
    help
	Pin Number where the NRST pin of the LoRa module is connected to.
	Set to -1 if the module's reset line is not wired to the MCU.

config MISO_GPIO
    int "MISO GPIO"
    range 0 48
    default 13
    help
	Pin Number to be used as the MISO SPI signal.

config MOSI_GPIO
    int "MOSI GPIO"
    range 0 48
    default 12
    help
	Pin Number to be used as the MOSI SPI signal.

config SCK_GPIO
    int "SCK GPIO"
    range 0 48
    default 14
    help
	Pin Number to be used as the SCK SPI signal.

endmenu
